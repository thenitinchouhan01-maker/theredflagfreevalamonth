{
  "name": "deeptrust-backend",
  "version": "1.0.0",
  "description": "DeepTrust - Anonymous Public Profile Discovery & Report System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedPlans.js",
    "test": "node scripts/test-local.js",
    "test:integration": "node scripts/test-local.js",
    "test:api": "node scripts/test-integration.js",
    "lint": "echo 'Linting not configured'",
    "validate-env": "node -e \"require('./config/env').validateEnv()\"",
    "check-config": "node -e \"const {getConfigSummary} = require('./config/env'); console.log(JSON.stringify(getConfigSummary(), null, 2));\""
  },
  "keywords": [
    "deeptrust",
    "public-profile",
    "report",
    "anonymous",
    "razorpay",
    "cloudflare-r2",
    "mongodb"
  ],
  "author": "DeepTrust",
  "license": "PRIVATE",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "axios": "^1.13.6",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.11.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.2",
    "uuid": "^9.0.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2"
  }
}
